@@ -0,0 +1,84 @@
+import { useEffect, useState } from "react";
+
+const PROXY_API_KEY = import.meta.env.VITE_PROXY_API_KEY || "test-key-123";
+
+/**
+ * Policy panel — the agent's pre-transaction rules (allowed categories,
+ * recipient allow/denylist, human-approval threshold). Static for the
+ * life of the process today (authorization/policy.py has no persistence
+ * yet), so this fetches GET /policy once and just displays it — no live
+ * updates needed, unlike WalletPanel's spend which changes every payment.
+ *
+ * Deliberately a separate component/panel from WalletPanel: wallet is a
+ * live, mutating balance; policy is a static rule set. Combining them
+ * would make the one thing that actually changes (spend) harder to
+ * glance at.
+ */
+export default function PolicyPanel() {
+  const [policy, setPolicy] = useState(null);
+  const [error, setError] = useState(null);
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const resp = await fetch("http://localhost:8000/policy", {
+          headers: { "X-API-Key": PROXY_API_KEY },
+        });
+        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
+        setPolicy(await resp.json());
+      } catch (err) {
+        setError(err.message);
+      }
+    })();
+  }, []);
+
+  return (
+    <div className="relative">
+      <button
+        className="text-xs border border-[var(--border)] rounded px-3 py-1.5 hover:border-[var(--blue)] hover:text-[var(--blue)]"
+        onClick={() => setOpen((v) => !v)}
+      >
+        Policy
+      </button>
+
+      {open && (
+        <div
+          className="absolute right-0 top-full mt-2 w-72 rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] shadow-2xl z-50 p-3 text-xs"
+        >
+          {error && <div className="text-[var(--red)]">Policy unavailable ({error})</div>}
+          {!policy && !error && <div className="text-[var(--text-muted)]">Loading…</div>}
+          {policy && (
+            <div className="space-y-2">
+              <div>
+                <div className="text-[var(--text-muted)] mb-1">Allowed categories</div>
+                <div className="flex flex-wrap gap-1">
+                  {policy.allowed_categories.map((c) => (
+                    <span key={c} className="px-1.5 py-0.5 rounded bg-[rgba(63,185,80,0.12)] text-[#3fb950] border border-[#3fb950]">
+                      {c}
+                    </span>
+                  ))}
+                </div>
+              </div>
+
+              <div>
+                <div className="text-[var(--text-muted)] mb-1">Recipient allowlist</div>
+                <div>{policy.recipient_allowlist ? policy.recipient_allowlist.join(", ") : "none (no restriction)"}</div>
+              </div>
+
+              <div>
+                <div className="text-[var(--text-muted)] mb-1">Recipient denylist</div>
+                <div>{policy.recipient_denylist.length ? policy.recipient_denylist.join(", ") : "empty"}</div>
+              </div>
+
+              <div>
+                <div className="text-[var(--text-muted)] mb-1">Human-approval threshold</div>
+                <div className="font-mono">₹{policy.human_approval_threshold.toLocaleString("en-IN")}</div>
+              </div>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
