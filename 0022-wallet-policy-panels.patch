diff --git a/dashboard/src/components/WalletPanel.jsx b/dashboard/src/components/WalletPanel.jsx
new file mode 100644
index 0000000..51a62df
--- /dev/null
+++ b/dashboard/src/components/WalletPanel.jsx
@@ -0,0 +1,73 @@
+import { useEffect, useState, useCallback } from "react";
+
+const PROXY_API_KEY = import.meta.env.VITE_PROXY_API_KEY || "test-key-123";
+
+/**
+ * Agent Wallet panel — the agent's own standing financial authority
+ * (per-txn limit, daily limit, spent today, remaining today), distinct
+ * from the workflow budget meter already in TopBar.jsx.
+ *
+ * Fetches GET /wallet/{agentId} on mount/connect so it shows real state
+ * BEFORE any payment is attempted, then refreshes live off the same
+ * authorization_trace check_wallet_authority events the log already
+ * prints — no extra polling needed once a workflow is running.
+ */
+export default function WalletPanel({ agentId = "primary_agent", liveWalletState }) {
+  const [wallet, setWallet] = useState(null);
+  const [error, setError] = useState(null);
+
+  const fetchWallet = useCallback(async () => {
+    try {
+      const resp = await fetch(`http://localhost:8000/wallet/${agentId}`, {
+        headers: { "X-API-Key": PROXY_API_KEY },
+      });
+      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
+      setWallet(await resp.json());
+      setError(null);
+    } catch (err) {
+      setError(err.message);
+    }
+  }, [agentId]);
+
+  useEffect(() => {
+    fetchWallet();
+  }, [fetchWallet]);
+
+  // A live authorization_trace event supersedes the last fetch — it's
+  // always at least as fresh, and arrives without a round trip.
+  useEffect(() => {
+    if (liveWalletState) setWallet((prev) => ({ ...prev, ...liveWalletState }));
+  }, [liveWalletState]);
+
+  if (error && !wallet) {
+    return (
+      <div className="text-xs text-[var(--text-muted)]">Wallet unavailable ({error})</div>
+    );
+  }
+  if (!wallet) {
+    return <div className="text-xs text-[var(--text-muted)]">Loading wallet…</div>;
+  }
+
+  const pct = wallet.daily_limit > 0 ? (wallet.spent_today / wallet.daily_limit) * 100 : 0;
+  const barColor = pct > 90 ? "#f85149" : pct > 70 ? "#d29922" : "#3fb950";
+
+  return (
+    <div className="text-right">
+      <div className="text-xs text-[var(--text-muted)] mb-1">
+        Agent Wallet <span className="opacity-60">· per-txn ≤₹{wallet.per_txn_limit.toLocaleString("en-IN")}</span>
+      </div>
+      <div className="flex items-center gap-2">
+        <div className="w-32 h-2 bg-[var(--bg-primary)] rounded-full overflow-hidden">
+          <div
+            className="h-full rounded-full transition-all duration-500"
+            style={{ width: `${Math.min(pct, 100)}%`, backgroundColor: barColor }}
+          />
+        </div>
+        <span className="text-sm font-mono font-semibold" style={{ color: barColor }}>
+          ₹{wallet.spent_today.toLocaleString("en-IN")}
+          <span className="text-[var(--text-muted)] font-normal"> / ₹{wallet.daily_limit.toLocaleString("en-IN")}</span>
+        </span>
+      </div>
+    </div>
+  );
+}
