# Aegis / RevertX — environment variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Every variable below is actually read somewhere in the codebase (grepped,
# not guessed — see the comment on each for the exact file). Anything not
# listed here has no effect.

# --- LLM (Gemini, free tier — see README for why Gemini instead of the
#     original spec's Anthropic API) -----------------------------------
# Required by both engine/policy_extractor.py and engine/anomaly_detector.py.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Redis (Aegis-only instance, port 6380 to avoid clashing with any
#     other Redis on the default 6379) ---------------------------------
# Read in: proxy/mcp_proxy.py, state_log/redis_client.py
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Postgres (durable transaction ledger + LangGraph checkpoints) -----
# Read in: db/client.py
PG_USER=aegis
PG_PASSWORD=aegispassword
PG_DB=aegis
PG_HOST=localhost
PG_PORT=5433

# --- Proxy auth (X-API-Key header + WebSocket ?token= query param) -----
# Read in: proxy/mcp_proxy.py as PROXY_API_KEY. This is the ONE canonical
# name to set. primary_agent/procurement_agent.py checks PROXY_API_KEY
# first and only falls back to a legacy API_KEY var (or the shared
# "test-key-123" default) if PROXY_API_KEY isn't set — so setting just
# PROXY_API_KEY below is enough; you no longer need to set both.
PROXY_API_KEY=test-key-123

# --- RazorpayX payout polling (Phase 2) ------------------------------
# Read in: razorpayx/client.py's poll_payout(). After create_payout(),
# the proxy re-checks the payout's status this many times, this many
# seconds apart, before treating it as "genuinely unknown" (queued/
# processing at timeout) rather than assuming success. Both have working
# defaults (2s x 3 = 6s worst case) — you don't need to set either.
RZP_POLL_INTERVAL_SECONDS=2
RZP_POLL_MAX_ATTEMPTS=3

# --- RazorpayX reversal payout (Phase 4 — Preset 3 flagship) -----------
# Read in: proxy/mcp_proxy.py, only for merchant_rzp payouts that reach
# "processed" and then fail their downstream fulfillment check.
# Fund account for the REVERSAL payout — must belong to the SAME
# RazorpayX account as RZP_DEMO_FUND_ACCOUNT_ID, distinct fund account.
# Provision with: python -m razorpayx.provision --self
RZP_SELF_FUND_ACCOUNT_ID=
# Read in: mock_merchants/downstream_service.py. When true (default),
# merchant_rzp's downstream fulfillment check always fails — this is the
# intended demo behavior for Preset 3. Set to false to rehearse Preset 1
# (clean happy path) on the exact same merchant_rzp payout path.
DOWNSTREAM_FORCE_FAIL=true

# --- RazorpayX deterministic pending payout (Phase 6 — Preset 2) -------
# Read in: proxy/mcp_proxy.py. When true (default), merchant_rzp_pending
# (catalog.py) skips the real poll loop and is forced to stay "pending" —
# reliable for a live demo instead of depending on RazorpayX test-mode
# timing. Set to false to let it resolve genuinely like merchant_rzp.
RZP_PENDING_DEMO_FORCE=true

# --- Pending payout auto-resolution (Phase 5) --------------------------
# Read in: compensating_agent/pending_payout_worker.py. A merchant_rzp
# payout that polls to "non_terminal" (Phase 2) gets rechecked this often,
# this many times, before the worker gives up and marks it 'exhausted'
# (needs a human to check the RazorpayX dashboard directly). Both have
# working defaults (15s x 8 = ~2min worst case) — you don't need to set
# either.
PENDING_PAYOUT_RECHECK_INTERVAL_SECONDS=15
PENDING_PAYOUT_MAX_CHECKS=8

# --- CORS -----------------------------------------------------------
# Read in: proxy/mcp_proxy.py. Comma-separated list, no spaces.
ALLOWED_ORIGINS=http://localhost:5173

# --- Isolated single-purpose LLM services --------------------------
# Read in: compensating_agent/graph.py. Only need to change these if you
# run policy_service/anomaly_service on non-default ports or hosts (e.g.
# the docker-compose containers instead of local uvicorn — see README).
POLICY_SERVICE_URL=http://localhost:8004
ANOMALY_SERVICE_URL=http://localhost:8005

# --- Planning agent (Phase 7) ----------------------------------------
# Read in: primary_agent/planner.py. Only used when procurement_agent.py
# is run with --goal (the fixed-script demo path doesn't call the
# planner at all, so these have no effect on it). Both have working
# defaults — you don't need to set either.
PLANNER_MODEL=gemini-3.5-flash-lite
PLANNER_TEMPERATURE=0.4

# --- Dashboard (Vite — this file is for the Python side; the dashboard
#     needs its OWN .env inside dashboard/, since Vite only picks up
#     VITE_-prefixed vars from a .env file in its own project root) -----
# Read in: dashboard/src/App.jsx, for the WebSocket auth token. Must match
# PROXY_API_KEY above or the dashboard's live-event stream will be
# rejected with a 1008 close code.
#
#   echo "VITE_PROXY_API_KEY=test-key-123" > dashboard/.env
