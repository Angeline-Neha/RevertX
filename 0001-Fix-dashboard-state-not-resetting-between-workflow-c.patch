From b77fc8ec1fa8491a62031646ac71c71cb748a141 Mon Sep 17 00:00:00 2001
From: Aegis Fix <aegis-fix@local>
Date: Thu, 27 Aug 2026 19:41:45 +0000
Subject: [PATCH] Fix dashboard state not resetting between workflow
 connections
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

connectWS() opened a new WebSocket for the target workflow_id but never
cleared terminalLines, nodeStates, compensationNodes, llmStream,
mathLine, endState, or budget. Connecting to a second (or third...)
workflow — by pasting a new UUID into the input, or reloading with a
different #hash — left every prior run's log lines and node states in
place, with the new run's events just appended on top. Visually this
showed up as: multiple 'Workflow initialised' lines interleaved with
contradictory budget numbers, and MANDATE EXCEEDED / compensation
STARTED / compensation complete repeating for different amounts all
under a single connected workflow_id, while the right-hand LLM
Reasoning and Deterministic Math panels stayed stuck on stale
'Waiting for...' text from whichever run happened to not yet reach
those nodes at reset time.

Added resetWorkflowState(), called at the top of connectWS() before
the previous socket is even replaced, so every connection — including
the very first one on mount — starts from a clean slate.
---
 dashboard/src/App.jsx | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/dashboard/src/App.jsx b/dashboard/src/App.jsx
index 5a3f4a7..e4196db 100644
--- a/dashboard/src/App.jsx
+++ b/dashboard/src/App.jsx
@@ -38,8 +38,25 @@ export default function App() {
     setTerminalLines((prev) => [...prev.slice(-200), `[${ts}] ${msg}`]);
   }, []);
 
+  // Clears every piece of per-workflow state. Must run before connecting to
+  // ANY workflow_id (including the very first one on mount) — otherwise
+  // switching workflows (typing a new UUID, or reloading with a different
+  // #hash) leaves the previous run's log lines, node states, and reasoning
+  // stream sitting in place, and the new run's events just get appended on
+  // top of them instead of starting clean.
+  const resetWorkflowState = useCallback(() => {
+    setTerminalLines([]);
+    setNodeStates({});
+    setCompensationNodes([]);
+    setLlmStream("");
+    setMathLine(null);
+    setEndState(null);
+    setBudget({ used: 0, limit: 0 });
+  }, []);
+
   const connectWS = useCallback((wid) => {
     if (wsRef.current) wsRef.current.close();
+    resetWorkflowState();
     const proxyApiKey = import.meta.env.VITE_PROXY_API_KEY || "test-key-123";
     const ws = new WebSocket(`ws://localhost:8000/ws/${wid}?token=${proxyApiKey}`);
     wsRef.current = ws;
@@ -60,7 +77,7 @@ export default function App() {
         handleEvent(msg);
       } catch {}
     };
-  }, [log]);
+  }, [log, resetWorkflowState]);
 
   function handleEvent(msg) {
     const { event_type, data } = msg;
