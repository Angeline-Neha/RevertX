+
+
+/* FULL PAGE COMMAND DECK LAYOUT */
+.app-shell { background:#070b14; }
+.deck-command-strip { display:flex; align-items:center; gap:22px; min-height:32px; padding:0 18px; border-top:1px solid rgba(87,214,255,.1); border-bottom:1px solid rgba(87,214,255,.16); background:#0b1220; color:var(--text-muted); font:9px var(--mono); letter-spacing:.1em; }
+.strip-title { color:var(--deck-cyan); font-weight:700; white-space:nowrap; }.strip-route { flex:1; text-align:center; color:#7785a5; }.strip-route b { color:var(--deck-cyan); padding:0 8px; }.strip-clock { color:var(--green); white-space:nowrap; }
+.deck-body { display:grid; grid-template-columns:280px minmax(0,1fr) 330px; flex:1; min-height:0; padding:10px; gap:10px; background:radial-gradient(circle at 50% 40%,rgba(72,76,168,.12),transparent 42%),#070b14; }
+.deck-rail { min-height:0; display:flex; flex-direction:column; position:relative; border:1px solid rgba(87,214,255,.16); background:linear-gradient(180deg,rgba(15,24,42,.98),rgba(7,12,23,.98)); box-shadow:0 12px 34px rgba(0,0,0,.3); }
+.deck-rail::before,.deck-rail::after { content:""; position:absolute; width:14px; height:14px; border-color:var(--deck-cyan); opacity:.7; pointer-events:none; }.deck-rail::before { left:-1px; top:-1px; border-left:1px solid; border-top:1px solid; }.deck-rail::after { right:-1px; bottom:-1px; border-right:1px solid; border-bottom:1px solid; }
+.rail-label { flex:0 0 30px; padding:10px 12px 8px; color:var(--deck-cyan); font:9px var(--mono); letter-spacing:.14em; border-bottom:1px solid rgba(87,214,255,.14); background:linear-gradient(90deg,rgba(87,214,255,.08),transparent); }
+.deck-rail > .command-panel { flex:1; min-height:0; width:auto; border:0; }
+.deck-stage { min-width:0; min-height:0; display:flex; flex-direction:column; border:1px solid rgba(143,134,255,.24); background:#080d18; box-shadow:0 0 0 1px rgba(87,214,255,.04),0 18px 50px rgba(0,0,0,.35); position:relative; overflow:hidden; }
+.deck-stage::before { content:""; position:absolute; inset:0; z-index:0; pointer-events:none; background-image:linear-gradient(rgba(87,214,255,.065) 1px,transparent 1px),linear-gradient(90deg,rgba(87,214,255,.065) 1px,transparent 1px); background-size:32px 32px; mask-image:linear-gradient(180deg,#000,transparent 90%); }
+.stage-toolbar { z-index:2; flex:0 0 34px; display:flex; justify-content:space-between; align-items:center; padding:0 13px; border-bottom:1px solid rgba(87,214,255,.16); background:rgba(10,17,31,.88); color:#aeb8d0; font:9px var(--mono); letter-spacing:.13em; }.stage-toolbar span { display:flex; align-items:center; gap:8px; }.stage-mode { color:var(--text-muted-2); }.stage-dot { width:6px; height:6px; border-radius:50%; background:var(--deck-purple); box-shadow:0 0 9px var(--deck-purple); animation:livepulse 1.6s infinite; }
+.deck-stage > .workflow-deck { z-index:1; flex:1; min-height:0; }.deck-stage > .workflow-deck > .panel-head { display:none; }.deck-stage .react-flow { background:transparent; }
+.deck-rail-right .reasoning-panel { border:0; }.deck-rail-right .math-box { flex:0 0 210px; }
+.telemetry-deck .wallet-card { transform-style:preserve-3d; transition:transform .55s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease; cursor:pointer; }.telemetry-deck .wallet-card:hover { transform:perspective(800px) rotateX(7deg) rotateY(-10deg) translateY(-7px) scale(1.025); box-shadow:-14px 20px 30px rgba(0,0,0,.45),0 0 32px rgba(87,214,255,.24); }.telemetry-deck .wallet-card:hover::after { content:"SECURE / TAP TO INSPECT"; position:absolute; right:14px; top:14px; color:var(--deck-cyan); font:8px var(--mono); letter-spacing:.12em; animation:deck-blink 1s steps(2,end) infinite; }.telemetry-deck .wallet-card:active { transform:perspective(800px) rotateX(0) rotateY(0) scale(.99); }
