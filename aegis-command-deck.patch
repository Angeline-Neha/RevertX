 .kv-row .v { color: var(--text-primary); font-variant-numeric: tabular-nums; font-weight: 500; }
+
+
+/* ================================================================
+   AEGIS COMMAND DECK — retro-futuristic incident console layer
+   Visual-only enhancement: existing data flow and component logic stay intact.
+================================================================ */
+:root {
+  --deck-cyan: #57d6ff;
+  --deck-cyan-soft: rgba(87,214,255,.16);
+  --deck-purple: #8f86ff;
+  --deck-ink: #090d17;
+  --deck-line: rgba(87,214,255,.18);
+  --deck-shadow: 0 18px 48px rgba(0,0,0,.32);
+}
+
+body {
+  background-color: var(--deck-ink);
+  background-image:
+    linear-gradient(rgba(87,214,255,.035) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(87,214,255,.035) 1px, transparent 1px),
+    radial-gradient(circle at 50% -20%, rgba(88,77,180,.22), transparent 48%),
+    radial-gradient(circle at 1px 1px, rgba(255,255,255,.035) 1px, transparent 0);
+  background-size: 36px 36px, 36px 36px, 100% 100%, 28px 28px;
+}
+
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  z-index: 100;
+  opacity: .055;
+  background: repeating-linear-gradient(0deg, transparent 0 3px, #fff 4px, transparent 5px);
+  mix-blend-mode: screen;
+}
+
+body::after {
+  content: "AEGIS // SECURE FINANCIAL ORCHESTRATION";
+  position: fixed;
+  right: 14px;
+  bottom: 4px;
+  pointer-events: none;
+  color: var(--deck-cyan);
+  opacity: .22;
+  font: 9px var(--mono);
+  letter-spacing: .16em;
+  z-index: 101;
+}
+
+.command-masthead {
+  position: relative;
+  background: linear-gradient(180deg, rgba(26,35,59,.92), rgba(12,17,30,.88));
+  box-shadow: 0 1px 0 rgba(87,214,255,.14), 0 10px 30px rgba(0,0,0,.24);
+}
+.command-masthead::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: -1px;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, var(--deck-cyan), transparent);
+  opacity: .7;
+}
+.brand-lockup { position: relative; }
+.wordmark {
+  text-shadow: 0 0 18px rgba(240,209,156,.24);
+  letter-spacing: .02em;
+}
+.brand-lockup::before {
+  content: "◈";
+  position: absolute;
+  left: -13px;
+  top: -3px;
+  color: var(--deck-cyan);
+  font: 9px var(--mono);
+  opacity: .8;
+  animation: deck-blink 1.8s steps(2,end) infinite;
+}
+.command-actions .ledger-btn { text-transform: uppercase; letter-spacing: .12em; font-size: 10px; }
+.command-actions .ledger-btn.primary { box-shadow: 0 0 20px rgba(219,169,85,.16); }
+
+.live-pill { text-transform: uppercase; letter-spacing: .12em; font-size: 9px; }
+.live-pill:not(.off) { box-shadow: 0 0 16px rgba(95,180,137,.14); }
+
+.hero-strip {
+  position: relative;
+  background: linear-gradient(90deg, rgba(19,27,44,.86), rgba(13,18,31,.94));
+  box-shadow: var(--deck-shadow);
+}
+.hero-strip::before {
+  content: "SYSTEM TELEMETRY / FINANCIAL STATE";
+  position: absolute;
+  left: 16px;
+  top: 4px;
+  color: var(--deck-cyan);
+  opacity: .48;
+  font: 8px var(--mono);
+  letter-spacing: .16em;
+}
+.hero-figure .amount { text-shadow: 0 0 22px rgba(240,209,156,.12); }
+.gauge-track { height: 8px; border-radius: 1px; box-shadow: inset 0 0 10px rgba(0,0,0,.5); }
+.gauge-fill { border-radius: 0; box-shadow: 0 0 12px rgba(95,180,137,.38); position: relative; }
+.gauge-fill::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent); animation: gauge-scan 2.4s linear infinite; }
+.wallet-card-wrap { filter: drop-shadow(0 0 18px rgba(87,214,255,.08)); }
+.wallet-card { border-radius: 4px; border-color: rgba(87,214,255,.32); box-shadow: 0 0 0 1px rgba(87,214,255,.05), 0 16px 32px -10px rgba(0,0,0,.55); }
+.wallet-card::after { content: ""; position: absolute; inset: 7px; border: 1px solid rgba(87,214,255,.08); pointer-events: none; }
+.wc-chip { border-radius: 2px; }
+
+.command-panel {
+  position: relative;
+  background: linear-gradient(180deg, rgba(20,28,46,.94), rgba(11,16,28,.96)) !important;
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
+}
+.command-panel::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  border: 1px solid rgba(87,214,255,.045);
+  clip-path: polygon(0 0, 14px 0, 14px 1px, 0 1px, 0 14px, 1px 14px, 1px 0, 100% 0, 100% 100%, 0 100%);
+}
+.panel-head {
+  text-transform: uppercase;
+  letter-spacing: .11em;
+  font-size: 9px;
+  background: linear-gradient(90deg, rgba(87,214,255,.055), transparent 70%);
+}
+.panel-head .title { color: #aeb8d0; }
+.panel-head .dot { box-shadow: 0 0 8px currentColor; }
+.signal-bars { display: inline-flex; align-items: end; gap: 2px; height: 10px; margin-left: 4px; }
+.signal-bars i { display: block; width: 2px; background: var(--deck-cyan); animation: signal-pulse 1.2s steps(2,end) infinite; }
+.signal-bars i:nth-child(1) { height: 4px; animation-delay: -.4s; }
+.signal-bars i:nth-child(2) { height: 7px; animation-delay: -.2s; }
+.signal-bars i:nth-child(3) { height: 10px; }
+.entry { transition: background .2s ease, transform .2s ease; }
+.entry:hover { background: rgba(87,214,255,.06); transform: translateX(2px); }
+.entry.is-fail { box-shadow: inset 0 0 20px rgba(227,101,76,.06); }
+
+.reasoning-panel .stream-state { color: var(--text-muted-2); font-size: 9px; letter-spacing: .14em; }
+.reasoning-panel .stream-state.active { color: var(--deck-cyan); text-shadow: 0 0 10px rgba(87,214,255,.6); animation: deck-blink 1.1s steps(2,end) infinite; }
+.stream-text { position: relative; color: #c6cbe0; text-shadow: 0 0 12px rgba(87,214,255,.08); }
+.stream-caret { display: inline-block; width: 7px; height: 14px; margin-right: 5px; vertical-align: -2px; background: var(--deck-cyan); opacity: .8; animation: caret-blink 1s steps(2,end) infinite; }
+.math-box { background: linear-gradient(180deg, rgba(8,12,21,.2), rgba(87,214,255,.025)); }
+
+.workflow-deck { background-image: radial-gradient(circle at center, rgba(87,214,255,.045), transparent 52%); }
+.workflow-deck .react-flow__pane { cursor: crosshair; }
+.workflow-deck .react-flow__background pattern circle { fill: rgba(87,214,255,.18); }
+.workflow-deck .react-flow__controls { box-shadow: 0 0 20px rgba(0,0,0,.4); }
+.workflow-deck .react-flow__controls button { background: #141d31; color: var(--deck-cyan); border-color: var(--deck-line); }
+.workflow-deck .react-flow__edge-path { filter: drop-shadow(0 0 4px currentColor); }
+.workflow-deck .react-flow__node { filter: drop-shadow(0 0 12px rgba(87,214,255,.08)); }
+
+.receipt { background: linear-gradient(180deg, rgba(25,34,55,.95), rgba(12,17,29,.98)); box-shadow: 0 -8px 24px rgba(0,0,0,.2); }
+.receipt-cell { position: relative; }
+.receipt-cell::before { content: ""; position: absolute; left: 16px; top: 0; width: 24px; height: 1px; background: var(--deck-cyan); opacity: .4; }
+.receipt-cell .value { text-shadow: 0 0 14px rgba(240,209,156,.1); }
+
+@keyframes deck-blink { 0%, 42% { opacity: .35; } 43%, 100% { opacity: 1; } }
+@keyframes caret-blink { 0%, 48% { opacity: .85; } 49%, 100% { opacity: 0; } }
+@keyframes signal-pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; box-shadow: 0 0 6px var(--deck-cyan); } }
+@keyframes gauge-scan { from { transform: translateX(-120%); } to { transform: translateX(220%); } }
+
+@media (max-width: 900px) {
+  body::after { display: none; }
+  .hero-strip::before { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
+}
+
+
+/* FULL COMMAND-DECK COMPOSITION */
+.command-header { display:grid; grid-template-columns: 1.25fr auto auto; align-items:center; gap:24px; padding:16px 20px 14px; min-height:88px; position:relative; background:linear-gradient(115deg,#111a2d 0%,#0b1221 58%,#15102b 100%); border-bottom:1px solid var(--deck-line); box-shadow:0 12px 40px rgba(0,0,0,.28); }
+.command-header::before { content:""; position:absolute; left:20px; right:20px; bottom:0; height:1px; background:linear-gradient(90deg,var(--deck-cyan),transparent 30%,transparent 70%,var(--deck-purple)); opacity:.8; }
+.command-brand { min-width:0; }
+.brand-eyebrow,.module-kicker { color:var(--deck-cyan); font:9px var(--mono); letter-spacing:.16em; text-transform:uppercase; opacity:.72; }
+.brand-eyebrow { display:flex; gap:7px; align-items:center; margin-bottom:4px; }
+.status-orb { width:6px; height:6px; background:var(--deck-cyan); border-radius:50%; box-shadow:0 0 10px var(--deck-cyan); animation:livepulse 1.8s infinite; }
+.brand-row { display:flex; align-items:baseline; gap:12px; }
+.brand-row .wordmark { font-size:34px; line-height:1; }
+.workflow-id { color:var(--text-muted); font:10px var(--mono); letter-spacing:.1em; margin-top:7px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.header-telemetry { display:flex; gap:8px; }
+.telemetry { display:grid; grid-template-columns:auto 1fr; column-gap:7px; min-width:76px; padding:8px 9px; border:1px solid rgba(87,214,255,.12); background:rgba(3,8,18,.38); }
+.telemetry-led { grid-row:span 2; align-self:center; width:6px; height:6px; background:var(--deck-cyan); box-shadow:0 0 9px currentColor; border-radius:50%; }
+.telemetry-label { color:var(--text-muted); font:8px var(--mono); letter-spacing:.14em; }
+.telemetry strong { color:var(--deck-cyan); font:10px var(--mono); letter-spacing:.08em; }
+.telemetry-green .telemetry-led,.telemetry-green strong { color:var(--green); background:var(--green); }
+.telemetry-warn .telemetry-led,.telemetry-warn strong { color:var(--blue); background:var(--blue); }
+.telemetry-purple .telemetry-led,.telemetry-purple strong { color:var(--deck-purple); background:var(--deck-purple); }
+.button-key { color:var(--deck-cyan); opacity:.65; margin-left:6px; }
+.telemetry-deck { display:grid; grid-template-columns:1.05fr 1.25fr 1.25fr 250px; gap:1px; background:var(--deck-line); border-bottom:1px solid var(--deck-line); }
+.telemetry-deck > * { min-height:122px; padding:18px 20px; background:linear-gradient(145deg,rgba(19,30,51,.98),rgba(10,16,29,.98)); }
+.module-kicker { margin-bottom:13px; }
+.balance-value { color:var(--text-primary); font:600 28px var(--serif); letter-spacing:.01em; text-shadow:0 0 20px rgba(240,209,156,.18); }
+.balance-value span { color:var(--blue); margin-right:3px; }
+.module-foot { color:var(--text-muted-2); font:8px var(--mono); letter-spacing:.12em; margin-top:10px; }
+.module-foot i { display:inline-block; width:5px; height:5px; background:var(--green); border-radius:50%; margin-left:4px; box-shadow:0 0 8px var(--green); }
+.authority-row,.mandate-row { display:flex; align-items:baseline; gap:8px; color:var(--text-muted); }
+.authority-row strong,.mandate-row strong { color:var(--text-primary); font:600 23px var(--mono); }
+.authority-row span,.mandate-row span { font:10px var(--mono); }
+.authority-track { height:4px; margin-top:12px; background:#080d18; }
+.authority-track span { display:block; height:100%; background:linear-gradient(90deg,var(--deck-cyan),var(--deck-purple)); box-shadow:0 0 10px rgba(87,214,255,.35); transition:width .7s ease; }
+.telemetry-deck .wallet-card-wrap { padding:0; min-height:122px; }
+.telemetry-deck .wallet-card { width:100%; height:100%; aspect-ratio:auto; border:0; border-left:1px solid rgba(87,214,255,.22); border-radius:0; box-shadow:none; background:radial-gradient(130% 150% at 100% 0%,#303967 0%,transparent 55%),linear-gradient(155deg,#202b47,#101622); }
+.card-signal { color:var(--deck-cyan); font:12px var(--mono); opacity:.8; }
+@media (max-width:1100px) { .command-header { grid-template-columns:1fr auto; } .header-telemetry { display:none; } .telemetry-deck { grid-template-columns:1fr 1fr 250px; } .balance-module { display:none; } }
+@media (max-width:760px) { .command-header { grid-template-columns:1fr; gap:12px; } .command-actions { justify-content:flex-start; } .telemetry-deck { grid-template-columns:1fr 1fr; } .telemetry-deck .wallet-card-wrap { grid-column:span 2; min-height:140px; } }
